{
  "appId": "com.buildos.desktop",
  "productName": "BuildOS AI",
  "directories": {
    "output": "dist-package"
  },
  "files": [
    "dist-electron/**/*",
    "renderer/dist/**/*",
    "package.json"
  ],
  "win": {
    "target": ["nsis", "portable"]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true
  },
  "mac": {
    "target": ["dmg", "zip"]
  },
  "linux": {
    "target": ["AppImage"]
  }
}

{
  "name": "@buildos/desktop",
  "version": "0.1.0",
  "private": true,
  "main": "dist-electron/apps/desktop/electron/main.js",
  "scripts": {
    "dev": "concurrently \"vite --config renderer/vite.config.ts\" \"tsc -p electron/tsconfig.json --watch\" \"wait-on tcp:5173 dist-electron/apps/desktop/electron/main.js && electron .\"",
    "build": "vite build --config renderer/vite.config.ts && tsc -p electron/tsconfig.json",
    "package": "npm run build && electron-builder --config electron-builder.config.json",
    "test": "vitest run",
    "electron:rebuild": "electron-rebuild -f -w better-sqlite3",
    "node:rebuild": "npm rebuild better-sqlite3"
  },
  "dependencies": {
    "@buildos/agents": "0.1.0",
    "@buildos/ai": "0.1.0",
    "@buildos/shared": "0.1.0",
    "@types/ws": "^8.18.1",
    "better-sqlite3": "^11.8.1",
    "electron": "^35.2.0",
    "gray-matter": "^4.0.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "ws": "^8.21.3",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "@tailwindcss/postcss": "^4.1.7",
    "@tailwindcss/vite": "^4.1.7",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.3",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.7",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.2",
    "wait-on": "^8.0.3"
  }
}
